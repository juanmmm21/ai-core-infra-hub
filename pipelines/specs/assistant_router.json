{
  "description": "Synthetic grammar for a personal assistant's intent router (project / general / trivial). Fictional project names; the routing rules follow the assistant's router instructions: code work goes to 'project', questions, mail, calendar, reminders, university and computer control to 'general', greetings and thanks to 'trivial'. Context tokens: active_project (a project is active), named_project (the message names one of the owner's repos), recent_general (a general conversation is in course).",
  "slots": {
    "project": ["Atlas", "Nimbus", "Orbita", "Kestrel", "Brisa", "Tundra", "Lumen", "Vega"],
    "thing": ["el login", "la búsqueda", "el parser", "la caché", "el endpoint de pagos", "el formulario de alta", "la API", "el exportador CSV", "las notificaciones", "el modo oscuro"],
    "test": ["el test de integración", "los tests unitarios", "el test que falla", "la suite de e2e", "el test de la API"],
    "time": ["a las ocho", "mañana", "el lunes", "esta tarde", "dentro de una hora", "el viernes a las diez", "pasado mañana"],
    "person": ["Ana", "Luis", "mi madre", "Carmen", "el casero", "Pablo", "la profe"],
    "place": ["Madrid", "Sevilla", "Jaén", "Granada", "Lisboa", "Roma", "Berlín"],
    "topic": ["la inflación", "el cambio climático", "la fotosíntesis", "la guerra fría", "los agujeros negros", "la dieta mediterránea"],
    "subject": ["redes", "bases de datos", "estadística", "sistemas operativos", "álgebra", "ingeniería del software"],
    "app": ["Spotify", "el navegador", "el Word", "la calculadora", "Discord", "el Excel"],
    "greeting": ["hola", "buenas", "buenos días", "hey", "qué tal", "buenas noches"],
    "thanks": ["gracias", "muchas gracias", "mil gracias", "genial, gracias", "perfecto, gracias", "gracias crack"]
  },
  "labels": {
    "project": [
      {"t": "arregla {test} de {project}"},
      {"t": "{test} está fallando, échale un ojo"},
      {"t": "haz commit y push de lo que tengas"},
      {"t": "mira por qué está rojo el CI de {project}"},
      {"t": "refactoriza {thing} que está fatal"},
      {"t": "añade validación a {thing}"},
      {"t": "implementa {thing} en {project}"},
      {"t": "sube la versión del paquete y etiqueta la release"},
      {"t": "revisa el último PR de {project}"},
      {"t": "¿cómo va {project}?"},
      {"t": "sigue con la siguiente casilla del PROGRESS"},
      {"t": "sigue avanzando con {project}"},
      {"t": "retoma {project} donde lo dejamos"},
      {"t": "hay un bug en {thing}, corrígelo"},
      {"t": "escribe tests para {thing}"},
      {"t": "el build no compila, arréglalo"},
      {"t": "migra {thing} a la nueva API"},
      {"t": "quita el código muerto de {thing}"},
      {"t": "sigue", "context": ["active_project"]},
      {"t": "continúa", "context": ["active_project"]},
      {"t": "dale", "context": ["active_project"]},
      {"t": "y ahora haz los tests", "context": ["active_project"]},
      {"t": "añádele {thing}", "context": ["named_project"]},
      {"t": "¿qué falla en el CI?", "context": ["active_project"]},
      {"t": "mira el error de compilación que me sale", "context": ["active_project"]}
    ],
    "general": [
      {"t": "¿qué tiempo hará {time} en {place}?"},
      {"t": "recuérdame llamar a {person} {time}"},
      {"t": "pon una alarma {time}"},
      {"t": "¿qué tengo {time} en el calendario?"},
      {"t": "mándale un correo a {person} diciendo que llego tarde"},
      {"t": "¿tengo algún correo importante?"},
      {"t": "explícame {topic} en dos frases"},
      {"t": "resume esta noticia sobre {topic}"},
      {"t": "traduce al inglés: nos vemos {time}"},
      {"t": "¿cuándo es la entrega de la práctica de {subject}?"},
      {"t": "¿ha salido ya la nota de {subject}?"},
      {"t": "abre {app}"},
      {"t": "hazme una captura de la pantalla"},
      {"t": "baja el volumen al treinta por ciento"},
      {"t": "¿cuánto ocupa la carpeta de descargas?"},
      {"t": "pon música relajada en {app}"},
      {"t": "busca vuelos a {place} para {time}"},
      {"t": "¿a qué hora cierra el súper hoy?"},
      {"t": "planifícame la semana de estudio de {subject}"},
      {"t": "mira lo que me sale en la pantalla"},
      {"t": "sigue", "context": ["recent_general"]},
      {"t": "bórralo", "context": ["recent_general"]},
      {"t": "cámbialo a las seis", "context": ["recent_general"]},
      {"t": "¿y el sábado?", "context": ["recent_general"]},
      {"t": "mándaselo a {person}", "context": ["recent_general"]},
      {"t": "recuérdame repasar {subject} {time}", "context": ["active_project"]},
      {"t": "¿qué tiempo hace en {place}?", "context": ["active_project"]},
      {"t": "abre {app}", "context": ["active_project"]}
    ],
    "trivial": [
      {"t": "{greeting}"},
      {"t": "{thanks}"},
      {"t": "{thanks}!"},
      {"t": "vale"},
      {"t": "ok, perfecto"},
      {"t": "jajaja"},
      {"t": "genial"},
      {"t": "de acuerdo"},
      {"t": "hasta luego"},
      {"t": "{greeting} de nuevo"},
      {"t": "buen trabajo"},
      {"t": "entendido"},
      {"t": "{thanks}", "context": ["active_project"]},
      {"t": "vale", "context": ["recent_general"]},
      {"t": "{greeting}", "context": ["active_project"]}
    ]
  }
}
